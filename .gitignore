# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Desko runtime data
# lyrics cache (regenerated on demand)
cache/
# user-specific; generated on first run (see config.example.json). May hold a
# secret calendar .ics URL, so keep it out of the repo.
config.json

# Runtime log — desko-hidden.vbs has no console, so it redirects the server's
# stdout/stderr here. Grows with every run; never belongs in the repo.
*.log

# Personal scratch notes / debug screenshots
bugs.txt
/image.png

# Full-resolution camera originals for the README photos. The committed copies
# in docs/images/ are resized and stripped of EXIF; these are 7MB each and git
# would keep every version of them forever.
docs/images/_originals/

# Experimental alternate frontend (not part of the shipping app)
new ui/

# Editor / OS / agent tooling
.vscode/
.idea/
.claude/settings.local.json
.DS_Store
Thumbs.db
